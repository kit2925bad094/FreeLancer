{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "/css/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/js/app.js"
    },
    {
      "source": "/((?!api|css|js|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
